    "def spearman_pair(d):\n",
    "    return d.ADL.rank().corr(d.FunctionalAssessment.rank())\n",
    "function=df.copy()\n",
    "function['ADL_percentile']=100*function.ADL.rank(method='average',pct=True)\n",
    "function['FA_percentile']=100*function.FunctionalAssessment.rank(method='average',pct=True)\n",
    "function['Rank_gap']=(function.ADL_percentile-function.FA_percentile).abs()\n",
    "rho=spearman_pair(function)\n",
    "rho_ci=bootstrap(function,spearman_pair,seed=2028)\n",
    "threshold_results=pd.DataFrame([{'Threshold (percentile points)':t,'n above':int(function.Rank_gap.gt(t).sum()),'Percent above':100*function.Rank_gap.gt(t).mean()} for t in [25,50]])\n",
    "display(threshold_results)\n",
    "quartile_table=pd.crosstab(pd.qcut(function.ADL,4,labels=['Q1','Q2','Q3','Q4']),pd.qcut(function.FunctionalAssessment,4,labels=['Q1','Q2','Q3','Q4']))\n",
    "display(quartile_table.rename_axis(index='ADL quartile',columns='FunctionalAssessment quartile'))\n",
    "display(Markdown(f'**Answer:** Spearman rho is **{rho:.3f}** (95% bootstrap interval {rho_ci[0]:.3f} to {rho_ci[1]:.3f}). The median absolute rank gap is **{function.Rank_gap.median():.1f} percentile points**. **{function.Rank_gap.gt(25).mean():.1%}** exceed a 25-point gap; **{function.Rank_gap.gt(50).mean():.1%}** exceed 50 points. The measures often order the same records differently, so replacing one with the other would substantially change who is relatively low or high in this dataset. This is relative-rank disagreement, not a clinical misclassification rate.'))\n",
    "fig,axes=plt.subplots(1,2,figsize=(10,4),layout='constrained')\n",
    "axes[0].scatter(function.ADL_percentile,function.FA_percentile,s=8,alpha=.22,color='#287c8e')\n",
    "axes[0].plot([0,100],[0,100],color='#df8b3b',linestyle='--',label='Equal relative rank')\n",
    "axes[0].set(xlabel='ADL percentile rank',ylabel='FunctionalAssessment percentile rank',xlim=(0,100),ylim=(0,100),title='Patient-level rank agreement')\n",
    "axes[0].legend(fontsize=8)\n",
    "axes[1].hist(function.Rank_gap,bins=np.arange(0,105,5),color='#287c8e',edgecolor='white')\n",
    "for threshold in [25,50]:axes[1].axvline(threshold,linestyle='--',label=f'{threshold}-point threshold')\n",
    "axes[1].set(xlabel='Absolute percentile-rank gap (points)',ylabel='Patient records',title='Magnitude of disagreement')\n",
    "axes[1].legend(fontsize=8)\n",
    "fig.suptitle('Figure 4. Functional measures are compared by relative rank')\n",
    "plt.show()\n"
   ]
