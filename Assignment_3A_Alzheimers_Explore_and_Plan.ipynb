    "def kappa_binary(a,b):\n",
    "    a=np.asarray(a); b=np.asarray(b)\n",
    "    observed=np.mean(a==b)\n",
    "    expected=a.mean()*b.mean()+(1-a.mean())*(1-b.mean())\n",
    "    return (observed-expected)/(1-expected) if expected < 1 else np.nan\n",
    "\n",
    "def bootstrap(data, statistic, repetitions=1000, seed=2026):\n",
    "    rng=np.random.default_rng(seed)\n",
    "    estimates=np.asarray([statistic(data.iloc[rng.integers(0,len(data),len(data))]) for _ in range(repetitions)])\n",
    "    return np.nanquantile(estimates,[.025,.975])\n",
    "\n",
    "def group_summary(data,group,value):\n",
    "    return data.groupby(group,observed=True)[value].agg(n='count',mean='mean',sd='std',median='median',q1=lambda s:s.quantile(.25),q3=lambda s:s.quantile(.75))\n",
    "\n",
    "memory_labels=['Neither','Complaints only','Forgetfulness only','Both']\n",
    "memory=df.assign(MemoryGroup=pd.Categorical(\n",
    "    np.select([df.MemoryComplaints.eq(1)&df.Forgetfulness.eq(1),df.MemoryComplaints.eq(1),df.Forgetfulness.eq(1)],\n",
    "              ['Both','Complaints only','Forgetfulness only'],default='Neither'),categories=memory_labels,ordered=True))\n",
    "tab=pd.crosstab(memory.MemoryComplaints,memory.Forgetfulness).reindex(index=[0,1],columns=[0,1],fill_value=0)\n",
    "display(tab.rename_axis(index='MemoryComplaints',columns='Forgetfulness'))\n",
    "display((100*tab.div(tab.sum(axis=1),axis=0)).rename_axis(index='MemoryComplaints: row %',columns='Forgetfulness'))\n",
    "n00,n01,n10,n11=tab.loc[0,0],tab.loc[0,1],tab.loc[1,0],tab.loc[1,1]\n",
    "kappa=kappa_binary(memory.MemoryComplaints,memory.Forgetfulness)\n",
    "kappa_ci=bootstrap(memory,lambda d:kappa_binary(d.MemoryComplaints,d.Forgetfulness))\n",
    "agreement=(n00+n11)/len(memory)\n",
    "display(pd.Series({'overall agreement':agreement,'positive agreement':2*n11/(2*n11+n01+n10),\n",
    "                   'negative agreement':2*n00/(2*n00+n01+n10),'Cohen kappa':kappa}).to_frame('Estimate'))\n",
    "display(group_summary(memory,'MemoryGroup','MMSE'))\n",
    "def memory_contrast(d):\n",
    "    return d.loc[d.MemoryGroup.eq('Both'),'MMSE'].mean()-d.loc[d.MemoryGroup.eq('Neither'),'MMSE'].mean()\n",
    "mmse_gap=memory_contrast(memory)\n",
    "mmse_gap_ci=bootstrap(memory,memory_contrast,seed=2027)\n",
    "display(Markdown(f'**Answer:** The indicators disagree in **{n01+n10:,}/{len(memory):,} records ({1-agreement:.1%})**. Kappa is **{kappa:.3f}** (95% bootstrap interval {kappa_ci[0]:.3f} to {kappa_ci[1]:.3f}); the observed agreement is therefore close to the agreement expected from their marginal frequencies when kappa is near zero. Mean MMSE for both indicators minus neither is **{mmse_gap:.2f} points** (interval {mmse_gap_ci[0]:.2f} to {mmse_gap_ci[1]:.2f}). These fields should not be treated as interchangeable, and disagreement does not identify which field is correct.'))\n",
    "fig,axes=plt.subplots(1,2,figsize=(11,4.5),layout='constrained')\n",
    "im=axes[0].imshow(tab,cmap='Blues',vmin=0)\n",
    "for i in range(2):\n",
    "    for j in range(2): axes[0].text(j,i,f'{tab.iloc[i,j]:,}',ha='center',va='center',color='white' if tab.iloc[i,j]>tab.to_numpy().max()/2 else 'black')\n",
    "axes[0].set(xticks=[0,1],xticklabels=['No','Yes'],yticks=[0,1],yticklabels=['No','Yes'],xlabel='Forgetfulness',ylabel='Memory complaints',title='Indicator overlap (counts)')\n",
    "axes[1].boxplot([memory.loc[memory.MemoryGroup.eq(g),'MMSE'] for g in memory_labels])\n",
    "axes[1].set(xticks=[1,2,3,4],xticklabels=['Neither','Complaints\\nonly','Forgetfulness\\nonly','Both'],ylabel='MMSE (score, 0–30)',ylim=(0,30),title='Cognition across indicator combinations')\n",
    "fig.suptitle('Figure 3. Do the two memory indicators agree?')\n",
    "plt.show()\n"
   ]
