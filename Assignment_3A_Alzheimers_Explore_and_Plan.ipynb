   "source": [
    "quality = pd.DataFrame(index=df.index)\n",
    "quality['BP_order_flag'] = df.SystolicBP.le(df.DiastolicBP)\n",
    "quality['Lipid_sum_flag'] = (df.CholesterolLDL + df.CholesterolHDL).gt(df.CholesterolTotal)\n",
    "quality['Any_flag'] = quality.any(axis=1)\n",
    "display(pd.DataFrame({'n':quality.sum(), 'percent':100*quality.mean()}))\n",
    "print('Both flags:', int((quality.BP_order_flag & quality.Lipid_sum_flag).sum()))\n",
    "quartiles=df[list(spec)].quantile([.25,.75])\n",
    "iqr=quartiles.loc[.75]-quartiles.loc[.25]\n",
    "iqr_flags=df[list(spec)].lt(quartiles.loc[.25]-1.5*iqr) | df[list(spec)].gt(quartiles.loc[.75]+1.5*iqr)\n",
    "display(iqr_flags.sum().rename('Outside 1.5 × IQR fences').to_frame())\n",
    "print('Text missing-value sentinels:', raw_text.apply(lambda s:s.str.strip().str.lower().isin(['na','n/a','null','none','unknown','?','-'])).sum().sum())\n",
    "display(df.groupby('Hypertension')[['SystolicBP','DiastolicBP']].agg(['count','mean','median']))\n",
    "print('The flags mark source-verification priorities, not confirmed erroneous diagnoses. Zero IQR outliers does not imply valid data.')\n"
   ]
  },
