    "robust=df.join(quality).assign(Rank_gap=function.Rank_gap)\n",
    "def agreement_metrics(d):\n",
    "    return np.array([kappa_binary(d.MemoryComplaints,d.Forgetfulness),spearman_pair(d),100*d.Rank_gap.gt(25).mean()])\n",
    "metric_names=['Memory kappa','Functional rank rho','Rank gap >25 points (%)']\n",
    "full=agreement_metrics(robust)\n",
    "unflagged=agreement_metrics(robust.loc[~robust.Any_flag])\n",
    "flagged=agreement_metrics(robust.loc[robust.Any_flag])\n",
    "comparison=pd.DataFrame({'Full sample':full,'Unflagged':unflagged,'Flagged':flagged},index=metric_names)\n",
    "display(pd.Series({'Full n':len(robust),'Unflagged n':int((~robust.Any_flag).sum()),'Flagged n':int(robust.Any_flag.sum())}).to_frame('Records'))\n",
    "display(comparison)\n",
    "rng=np.random.default_rng(2029)\n",
    "changes=[]\n",
    "for _ in range(1000):\n",
    "    sample=robust.iloc[rng.integers(0,len(robust),len(robust))]\n",
    "    changes.append(agreement_metrics(sample.loc[~sample.Any_flag])-agreement_metrics(sample))\n",
    "change_ci=np.nanquantile(changes,[.025,.975],axis=0)\n",
    "change_table=pd.DataFrame({'Change: unflagged minus full':unflagged-full,'95% lower':change_ci[0],'95% upper':change_ci[1],'Descriptive material-change tolerance':[.10,.10,5]},index=metric_names)\n",
    "display(change_table)\n",
    "material=np.abs(unflagged-full)>=np.array([.10,.10,5])\n",
    "display(Markdown(f'**Answer:** The rule flags **{robust.Any_flag.sum():,} records ({robust.Any_flag.mean():.1%})**, leaving **{(~robust.Any_flag).sum():,}**. Exclusion changes memory kappa by **{unflagged[0]-full[0]:+.3f}**, functional rho by **{unflagged[1]-full[1]:+.3f}**, and the large-rank-gap proportion by **{unflagged[2]-full[2]:+.2f} percentage points**. **{material.sum()} of 3** observed changes exceed the stated descriptive tolerances. Interpret the interval table as uncertainty about the change, not proof of equivalence or permission to label the remaining rows clean.'))\n",
    "fig,axes=plt.subplots(1,3,figsize=(11,3.7),layout='constrained')\n",
    "for i,ax in enumerate(axes):\n",
    "    ax.plot([0,1],[full[i],unflagged[i]],'o-',color='#287c8e')\n",
    "    ax.set(xticks=[0,1],xticklabels=['All records','Unflagged'],title=metric_names[i],ylabel='Percent of records' if i==2 else 'Coefficient',xlim=(-.3,1.3))\n",
    "    if i<2:ax.set_ylim(-.15,.15);ax.axhline(0,color='gray',linestyle='--',linewidth=.8)\n",
    "    else:ax.set_ylim(0,100)\n",
    "    for x,v in enumerate([full[i],unflagged[i]]):ax.annotate(f'{v:.3f}' if i<2 else f'{v:.1f}%',(x,v),xytext=(0,10),textcoords='offset points',ha='center')\n",
    "fig.suptitle('Figure 5. Sensitivity to excluding cross-field quality flags')\n",
    "plt.show()\n"
