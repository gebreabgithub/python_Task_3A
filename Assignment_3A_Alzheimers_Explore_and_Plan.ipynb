   "source": [
    "audit = pd.DataFrame({'missing':df.isna().sum(), 'unique':df.nunique(dropna=False)})\n",
    "audit['blank_strings'] = [df[c].map(lambda x: isinstance(x,str) and not x.strip()).sum() for c in df]\n",
    "display(audit)\n",
    "print('Exact duplicate rows:', df.duplicated().sum())\n",
    "print('Duplicate rows excluding PatientID:', df.drop(columns='PatientID').duplicated().sum())\n",
    "print('Duplicate IDs:', df.PatientID.duplicated().sum())\n",
    "print('Constant columns:', df.columns[df.nunique(dropna=False).eq(1)].tolist())\n",
    "print('Observed ID range:', df.PatientID.min(), df.PatientID.max())\n",
    "print('IDs absent from stated 4751–6900 range:', sorted(set(range(4751,6901))-set(df.PatientID)))\n",
    "print('Nonfinite numeric cells:', (~np.isfinite(df.select_dtypes('number')) & df.select_dtypes('number').notna()).sum().sum())\n",
    "\n",
    "validation=[]\n",
    "for c,(lo,hi,unit) in spec.items():\n",
    "    validation.append([c, int((df[c].notna() & ~df[c].between(lo,hi)).sum())])\n",
    "for c,mapping in category_maps.items():\n",
    "    validation.append([c, int((df[c].notna() & ~df[c].isin(mapping)).sum())])\n",
    "validation.append(['PatientID', int((~df.PatientID.between(4751,6900) | df.PatientID.mod(1).ne(0)).sum())])\n",
    "validation.append(['DoctorInCharge', int(df.DoctorInCharge.ne('XXXConfid').sum())])\n",
    "display(pd.DataFrame(validation, columns=['Variable','Invalid range / code count']))\n",
    "quality_flags = {\n",
    "    'SystolicBP <= DiastolicBP': int((df.SystolicBP <= df.DiastolicBP).sum()),\n",
    "    'CholesterolLDL > CholesterolTotal': int((df.CholesterolLDL > df.CholesterolTotal).sum()),\n",
    "    'Fractional MMSE scores': int((~np.isclose(df.MMSE, df.MMSE.round(), atol=1e-8, rtol=0)).sum())}\n",
    "display(pd.Series(quality_flags, name='Rows flagged').to_frame())\n",
    "raw_text = pd.read_csv(DATA_PATH, dtype=str)\n",
    "precision = {c:raw_text[c].str.extract(r'\\.(\\d+)',expand=False).str.len().max() for c in spec}\n",
    "display(pd.Series(precision,name='Maximum decimal places in original CSV').to_frame())\n",
    "print('Flags do not trigger automatic removal or rounding.')\n"
